command = /usr/bin/zsh


# Font
font-family = JetBrains Mono
font-size = 12
font-thicken = true

# Window
window-padding-x = 14
window-padding-y = 12
window-decoration = true
window-theme = dark

# Background
background = #0b0b12
foreground = #e4e4ed
background-opacity = 0.96

# Cursor
cursor-style = block
cursor-color = #a78bfa
cursor-text = #0b0b12

# Selection
selection-background = #37304f
selection-foreground = #ffffff

# ==========================================
# COLOR PALETTE
# ==========================================

# Normal colors
palette = 0=#171722
palette = 1=#ff6b81
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#cba6f7
palette = 6=#67e8f9
palette = 7=#cdd6f4

# Bright colors
palette = 8=#45455a
palette = 9=#ff8499
palette = 10=#b5e8ad
palette = 11=#fce7b2
palette = 12=#9bbcff
palette = 13=#d8b4fe
palette = 14=#8be9fd
palette = 15=#ffffff

# ==========================================
# BEHAVIOR
# ==========================================

# Hide cursor while typing
mouse-hide-while-typing = true

# Shell integration
shell-integration = detect

# Scrollback
scrollback-limit = 10000

# Reload configuration
keybind = ctrl+shift+comma=reload_config
